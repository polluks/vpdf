+
+int GooFile::read(char *buf, int n, Goffset offset) const {
+  if (ftell(file) != offset)
+  {
+    fseek(file, offset, SEEK_SET);
+  }
+
+  return fread(buf, 1, n, file); 
+}
+
+Goffset GooFile::size() const {
+  return filesize;
+}
+
+std::unique_ptr<GooFile> GooFile::open(const std::string &fileName) {
+  FILE *f = fopen(fileName.c_str(), "rb");
+  
+  if (f != NULL)
+  {
+    struct FileInfoBlock fib;
+    int size = 0;
+    BPTR fh = Open(fileName.c_str(), ACCESS_READ);
+    if (fh != (BPTR)NULL)
+    {
+      ExamineFH(fh, &fib);
+      size = fib.fib_Size;
+      Close(fh);
+    }
+
+    return std::unique_ptr<GooFile>(new GooFile(f, size));
+  }
+
+  return std::unique_ptr<GooFile>();
+}
+
+bool GooFile::modificationTimeChangedSinceOpen() const
+{
+#if 1
